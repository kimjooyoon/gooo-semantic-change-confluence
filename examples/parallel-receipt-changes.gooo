{
  "schema": "gooo/source-input/v1",
  "case_id": "normal-independent",
  "source_id": "receipt-demo",
  "contract": "receipt/v1",
  "toolchain": "go1.27.0",
  "runner": "gooo-confluence-ci",
  "baseline": {
    "receipt.id": "r-100",
    "receipt.total": "1250"
  },
  "operations": [
    {
      "id": "change-a",
      "name": "AddCurrencyCode",
      "kind": "parallel-semantic-change",
      "depends_on": [],
      "authority": "source-owner-a",
      "guardrails": ["preserve-receipt-id", "write-declared-scope-only"],
      "scope": ["receipt.currency"],
      "patches": [{"path": "receipt.currency", "value": "KRW"}]
    },
    {
      "id": "change-b",
      "name": "AddTaxCode",
      "kind": "parallel-semantic-change",
      "depends_on": [],
      "authority": "source-owner-b",
      "guardrails": ["preserve-receipt-id", "write-declared-scope-only"],
      "scope": ["receipt.tax_code"],
      "patches": [{"path": "receipt.tax_code", "value": "VAT"}]
    }
  ]
}
